      "[2. 2. 2.]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "\n",
    "y = np.array([2, 1, 3])\n",
    "phi = np.array([1, 1, 1])\n",
    "\n",
    "beta = (phi @ y)/ (phi @ phi) # no need to transpose phi, it is implicitly treated as row vector aka 1D array\n",
    "print(beta)\n",
    "\n",
    "H = phi @ (phi) / (phi @ phi)\n",
    "print(H)\n",
    "\n",
    "\n",
    "y_hat = H @ y\n",
    "print(y_hat)\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "636cbbc6",
   "metadata": {},
   "source": [
    "## Answer -> \n",
    "So why is y = y_hat? it is simple. H becomes a scaler, by doing the dotproduct theta @ (theta) / (theta @ theta), we get (1x1 + 1x1 + 1x1)/(1x1 + 1x1 + 1x1) = 1. So when we do H*y it just stays the same since the scalar H is 1. And the df of H is one, since it is a NxN matrixs, so 1x1, trace(H) = df."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9ead4e39",
   "metadata": {},
   "source": [
    "## Exercise 3"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "c8e6f418",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "beta: [ 6.  -5.5  1.5]\n",
      "trace(H): 2.9999999999999645\n",
      "y_hat: [2. 1. 3.]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "y = np.array([2, 1, 3], dtype=float)             \n",
    "Phi = np.array([[1,1,1],\n",
    "                [1,2,4],\n",
    "                [1,3,9]], dtype=float)           \n",
    "\n",
    "# beta (normal equation)\n",
    "beta = np.linalg.inv(Phi.T @ Phi) @ Phi.T @ y    \n",
    "print(\"beta:\", beta)  \n",
    "\n",
    "# hat matrix and predictions\n",
    "H = Phi @ np.linalg.inv(Phi.T @ Phi) @ Phi.T    \n",
    "print(\"trace(H):\", np.trace(H))                  \n",
    "\n",
    "y_hat = H @ y                                    \n",
    "print(\"y_hat:\", y_hat)                      \n",
    "\n",
    "\n"
   ]
  },
